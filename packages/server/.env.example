# 서버 포트
PORT=3000

# 인증 토큰 — 24자 이상 필수, 플레이스홀더(change-me*) 값으로는 기동 불가
# 두 토큰은 서로 다른 값이어야 함 (같으면 기동 거부 — 권한 분리)
# 생성: openssl rand -hex 32 (각각 따로 실행)
# 클라이언트(웹 콘솔·CLI·SDK)용
NEBULA_CLIENT_TOKEN=change-me-run-openssl-rand-hex-32
# Agent(맥미니 데몬) WS 터널용
NEBULA_AGENT_TOKEN=change-me-run-openssl-rand-hex-32

# SQLite 파일 경로 (기본: ./nebula.sqlite)
DB_PATH=./nebula.sqlite

# Swagger 문서(/docs) 노출 여부 — 인증 없이 공개되므로 로컬 개발에서만 true 권장
ENABLE_DOCS=false
