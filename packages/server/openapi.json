            "description": "기기 응답 시간 초과",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "하드웨어 버튼 (home)",
        "tags": [
          "commands"
        ]
      }
    },
    "/devices/{id}/actions/screenshot": {
      "post": {
        "operationId": "CommandsController_screenshot",
