        ]
      }
    }
  },
  "info": {
    "title": "nebula-clone",
    "description": "디바이스 팜 오케스트레이션 API",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string",
            "example": "Not Found"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "PublicDeviceDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "기기 UDID"
          },
          "name": {
            "type": "string",
            "description": "기기 이름"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "osVersion": {
            "type": "string"
          },
          "tags": {
            "description": "기기 태그 (controller-ready 등)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline"
            ]
          },
          "agentId": {
            "type": "string",
            "nullable": true,
            "description": "관리 Agent ID (오프라인 시 null)"
          },
          "occupiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "점유 시각"
          },
          "lastHeartbeatAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "lastActivityAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "마지막 점유 활동 시각 (sliding TTL 기준)"
          },
          "isOccupied": {
            "type": "boolean",
            "description": "점유 중 여부 (occupantId는 응답에 포함하지 않음)"
          }
        },
        "required": [
          "id",
          "name",
          "platform",
          "osVersion",
          "tags",
          "status",
          "agentId",
          "occupiedAt",
          "lastHeartbeatAt",
          "lastActivityAt",
          "isOccupied"
        ]
      },
      "OccupyDeviceDto": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ],
            "description": "플랫폼 필터"
          },
          "tags": {
            "description": "기기 태그 필터 (모두 일치)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deviceId": {
            "type": "string",
            "description": "특정 기기 지정 점유 (UDID)"
          }
        }
      },
      "OccupyResponseDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유자 ID — 해제·명령·keepalive에 필요한 비밀값"
          },
          "device": {
            "$ref": "#/components/schemas/PublicDeviceDto"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "점유 만료 예정 시각 — 명령·keepalive 활동 시 연장"
          }
        },
        "required": [
          "occupantId",
          "device",
          "expiresAt"
        ]
      },
      "KeepaliveDeviceDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          }
        },
        "required": [
          "occupantId"
        ]
      },
      "KeepaliveResponseDto": {
        "type": "object",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/PublicDeviceDto"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "device",
          "expiresAt"
        ]
      },
      "ReleaseDeviceDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          }
        },
        "required": [
          "occupantId"
        ]
      },
      "TapDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          },
          "x": {
            "type": "number",
            "description": "x 좌표 (pt)"
          },
          "y": {
            "type": "number",
            "description": "y 좌표 (pt)"
          }
        },
        "required": [
          "occupantId",
          "x",
          "y"
        ]
      },
      "AckResultDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "AckCommandResponseDto": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/AckResultDto"
          }
        },
        "required": [
          "result"
        ]
      },
      "SwipeDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          },
          "fromX": {
            "type": "number"
          },
          "fromY": {
            "type": "number"
          },
          "toX": {
            "type": "number"
          },
          "toY": {
            "type": "number"
          },
          "durationMs": {
            "type": "number",
            "description": "스와이프 시간 (ms, 기본 300)"
          }
        },
        "required": [
          "occupantId",
          "fromX",
          "fromY",
          "toX",
          "toY"
        ]
      },
      "TypeTextDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          },
          "text": {
            "type": "string",
            "description": "입력할 텍스트 (한글·이모지 지원은 Controller 구현에 따름)"
          }
        },
        "required": [
          "occupantId",
          "text"
        ]
      },
      "UiDumpDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          }
        },
        "required": [
          "occupantId"
        ]
      },
      "UiDumpResultDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "tree": {
            "type": "string",
            "description": "접근성 트리 텍스트"
          }
        },
        "required": [
          "ok",
          "tree"
        ]
      },
      "UiDumpCommandResponseDto": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/UiDumpResultDto"
          }
        },
        "required": [
          "result"
        ]
      },
      "PressButtonDto": {
        "type": "object",
        "properties": {
          "occupantId": {
            "type": "string",
            "description": "점유 시 발급된 점유자 ID"
          },
          "button": {
            "type": "string",
            "enum": [
              "home",
              "back"
            ],
            "description": "하드웨어 버튼 — back은 Android 전용"
          }
        },
        "required": [
          "occupantId",
          "button"
        ]
      },
      "ScreenshotResultDto": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "jpegBase64": {
            "type": "string",
            "description": "JPEG 이미지 (base64)"
          },
          "coordWidth": {
            "type": "number",
            "description": "탭 좌표 기준계 폭 — iOS는 pt, Android는 px (Agent가 정규화)"
          },
          "coordHeight": {
            "type": "number",
            "description": "탭 좌표 기준계 높이"
          }
        },
        "required": [
          "ok",
          "jpegBase64",
          "coordWidth",
          "coordHeight"
        ]
      },
      "ScreenshotCommandResponseDto": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/ScreenshotResultDto"
          }
        },
        "required": [
          "result"
        ]
      }
    }
  }
}
