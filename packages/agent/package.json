{
  "name": "@nebula/agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "pnpm --filter @nebula/shared build && node --env-file-if-exists=.env -r ts-node/register src/main.ts",
    "test": "jest"
  },
  "dependencies": {
    "@nebula/shared": "workspace:*",
    "pino": "^10.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
