# 서버 WS 터널 주소 (오라클 배포 시 wss://<domain>/agent)
NEBULA_SERVER_URL=ws://localhost:3000/agent
# 서버와 동일한 Agent 토큰 (24자 이상)
NEBULA_AGENT_TOKEN=change-me-run-openssl-rand-hex-32
# 미지정 시 호스트명 기반 자동 생성
NEBULA_AGENT_ID=mac-mini-1
# 기기 스캔 주기 (기본 20000)
#NEBULA_DISCOVERY_INTERVAL_MS=20000
# 하트비트 주기 (기본 25000) — 서버 NEBULA_HEARTBEAT_TIMEOUT_MS(기본 90000)의 1/3 이하 유지
#NEBULA_HEARTBEAT_INTERVAL_MS=25000
# 러너 헬스 폴링 주기 (기본 10000)
#NEBULA_CONTROLLER_HEALTH_INTERVAL_MS=10000

# ── iOS Controller (수퍼바이저) — Agent가 기기별 xcodebuild 러너·iproxy를 자동 기동·감시 ──
#   사전 조건: codesign 키체인 "항상 허용" 1회, 기기 개발자 모드·신뢰 (controller-ios/README.md)
#NEBULA_XCODEBUILD_ENABLED=true
#NEBULA_CONTROLLER_PROJECT=<repo>/controller-ios/NebulaController.xcodeproj
#NEBULA_CONTROLLER_SCHEME=NebulaController
#NEBULA_CONTROLLER_BASE_PORT=8200

# Controller HTTP 토큰 (선택, 24자 이상) — 설정 시 러너 env와 요청 헤더에 자동 배선.
# 기기 내 다른 앱이 127.0.0.1 러너에 접근하는 것 차단 (미설정 시 러너는 무인증)
#NEBULA_CONTROLLER_TOKEN=

# 기기 없이 파이프라인 개발 시 정적 기기 등록
#NEBULA_STATIC_DEVICES=[{"id":"fake-1","name":"Fake","osVersion":"17.0","tags":["fake"]}]
# 수퍼바이저 진단 경로 (선택 — 기본 ~/.nebula 하위)
#NEBULA_DERIVED_DATA_DIR=~/.nebula/derived-data
#NEBULA_CONTROLLER_LOG_DIR=~/.nebula/logs

# ── Android ─────────────────────────────────────────────────
# adb가 설치돼 있으면 Android(발견·제어·미러링)는 자동 활성 — 켜는 플래그 없음.
# 러너 APK·미러 dex 경로는 레포 빌드 산출물로 자동 계산 (scripts/build-android.sh로 빌드).
# adb 경로도 PATH·표준 위치에서 자동 탐색 — 아래는 비표준 위치일 때만 지정
#NEBULA_ADB_PATH=/opt/homebrew/bin/adb
# adb forward 로컬 포트 시작값 (기본 8300 — iOS 8200과 분리)
#NEBULA_ANDROID_BASE_PORT=8300
# 미러링 forward 포트 시작값 (기본 8400 — 러너 8300과 분리)
#NEBULA_ANDROID_MIRROR_BASE_PORT=8400

# ── Android 튜닝 (전부 선택 — 미지정 시 아래 기본값) ─────────
# 러너 수퍼바이저 타이밍
#NEBULA_ANDROID_HEALTH_INTERVAL_MS=10000     # 러너 헬스 폴링 주기
#NEBULA_ANDROID_HEALTH_FAIL_THRESHOLD=3      # 연속 헬스 실패 → 재기동
#NEBULA_ANDROID_RESTART_BASE_MS=2000         # 재기동 백오프 시작
#NEBULA_ANDROID_RESTART_MAX_MS=60000         # 재기동 백오프 상한
#NEBULA_ANDROID_KILL_ESCALATION_MS=3000      # SIGTERM→SIGKILL 승격 대기
#NEBULA_ANDROID_PORT_COOLDOWN_MS=5000        # 포트 반납 쿨다운
#NEBULA_ANDROID_READY_DEADLINE_MS=60000      # 준비 데드라인 (초과 시 강제 재기동)
#NEBULA_ANDROID_REINSTALL_AFTER_FAILURES=3   # 연속 실패 시 APK 재설치
# 러너(device) 액션 타이밍 — am instrument -e로 기기에 전달
#NEBULA_ANDROID_ACTION_TIMEOUT_MS=9000       # 액션 큐 대기+실행 상한 (초과 503)
#NEBULA_ANDROID_SWIPE_STEP_MS=8              # 스와이프 MOVE 간격 (~120Hz)
#NEBULA_ANDROID_MAX_SWIPE_DURATION_MS=8000   # 스와이프 최대 지속
# 미러링 스트림 (agent 쪽)
#NEBULA_ANDROID_MIRROR_RESTART_BASE_MS=2000
#NEBULA_ANDROID_MIRROR_RESTART_MAX_MS=60000
#NEBULA_ANDROID_MIRROR_ERROR_THRESHOLD=5     # 연속 재기동 warn→error 승격
#NEBULA_ANDROID_MIRROR_KILL_ESCALATION_MS=2000
#NEBULA_ANDROID_MIRROR_PREAMBLE_DEADLINE_MS=10000  # 프리앰블 미수신 → 재기동
#NEBULA_ANDROID_MIRROR_CONNECT_RETRY_MS=500  # 데몬 listen 전 접속 재시도 간격
# 미러링 인코더 (device) — app_process 인자로 데몬에 전달
#NEBULA_ANDROID_MIRROR_BITRATE=8000000       # H.264 비트레이트 (bps)
#NEBULA_ANDROID_MIRROR_FPS=60
#NEBULA_ANDROID_MIRROR_IFRAME_SEC=1          # 키프레임 간격 (초)
#NEBULA_ANDROID_MIRROR_REPEAT_FRAME_MS=100   # 정지 화면 재발행 주기
#NEBULA_ANDROID_MIRROR_SWAP_POLL_MS=500      # 접힘/펼침 SWAP 감지 폴링
#NEBULA_ANDROID_MIRROR_ACCEPT_DEADLINE_MS=30000  # 데몬 접속 대기 상한
