# 서버 WS 터널 주소 (오라클 배포 시 wss://<domain>/agent)
NEBULA_SERVER_URL=ws://localhost:3000/agent
# 서버와 동일한 Agent 토큰 (24자 이상)
NEBULA_AGENT_TOKEN=change-me-run-openssl-rand-hex-32
# 미지정 시 호스트명 기반 자동 생성
NEBULA_AGENT_ID=mac-mini-1
# 기기 스캔 주기 (기본 20000)
#NEBULA_DISCOVERY_INTERVAL_MS=20000
# 하트비트 주기 (기본 25000) — 서버 NEBULA_HEARTBEAT_TIMEOUT_MS(기본 90000)의 1/3 이하 유지
#NEBULA_HEARTBEAT_INTERVAL_MS=25000
# 러너 헬스 폴링 주기 (기본 10000)
#NEBULA_CONTROLLER_HEALTH_INTERVAL_MS=10000

# ── Controller 연결 방식 (둘 중 하나) ──────────────────────
# 방식 1) 수퍼바이저 모드 — Agent가 기기별 xcodebuild 러너·iproxy를 자동 기동·감시
#   사전 조건: codesign 키체인 "항상 허용" 1회, 기기 개발자 모드·신뢰 (controller-ios/README.md)
#NEBULA_XCODEBUILD_ENABLED=true
#NEBULA_CONTROLLER_PROJECT=<repo>/controller-ios/NebulaController.xcodeproj
#NEBULA_CONTROLLER_SCHEME=NebulaController
#NEBULA_CONTROLLER_BASE_PORT=8200

# 방식 2) 정적 포트 모드 — 러너·iproxy를 수동으로 띄운 경우
#NEBULA_CONTROLLER_PORTS=<UDID>:8100

# Controller HTTP 토큰 (선택, 24자 이상) — 설정 시 러너 env와 요청 헤더에 자동 배선.
# 기기 내 다른 앱이 127.0.0.1 러너에 접근하는 것 차단 (미설정 시 러너는 무인증)
#NEBULA_CONTROLLER_TOKEN=

# 기기 없이 파이프라인 개발 시 정적 기기 등록
#NEBULA_STATIC_DEVICES=[{"id":"fake-1","name":"Fake","osVersion":"17.0","tags":["fake"]}]
# 수퍼바이저 진단 경로 (선택 — 기본 ~/.nebula 하위)
#NEBULA_DERIVED_DATA_DIR=~/.nebula/derived-data
#NEBULA_CONTROLLER_LOG_DIR=~/.nebula/logs

# H.264 미러링 헬퍼 — 미지정 시 미러링 비활성 (조작·UI 덤프는 동작)
#   빌드: cd mirror-helper && swift build
#NEBULA_MIRROR_HELPER=<repo>/mirror-helper/.build/debug/mirror-helper

# ── Android (선택) ──────────────────────────────────────────
# adb 기기 발견 활성 (미설정 시 Android 전 기능 비활성)
#NEBULA_ADB_ENABLED=true
# adb 경로 (기본 /opt/homebrew/bin/adb — brew install --cask android-platform-tools)
#NEBULA_ADB_PATH=/opt/homebrew/bin/adb
# 러너 APK — 미지정 시 발견만 되고 제어 비활성. 빌드: scripts/build-android.sh
#NEBULA_ANDROID_RUNNER_APK=<repo>/android-controller/runner/build/outputs/apk/debug/runner-debug.apk
# adb forward 로컬 포트 시작값 (기본 8300 — iOS 8200과 분리)
#NEBULA_ANDROID_BASE_PORT=8300
# 미러링 데몬 dex — 미지정 시 Android 미러링 비활성 (조작·UI 덤프는 동작). 빌드: scripts/build-android.sh
#NEBULA_ANDROID_MIRROR_DEX=<repo>/android-controller/mirror/build/outputs/apk/debug/mirror-debug.apk
# 미러링 forward 포트 시작값 (기본 8400 — 러너 8300과 분리)
#NEBULA_ANDROID_MIRROR_BASE_PORT=8400
